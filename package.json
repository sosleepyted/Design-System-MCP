{
  "name": "ucm-design",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:ui": "pnpm --filter @ucm/ui build",
    "dev:docs": "pnpm build:ui && pnpm --filter @ucm/docs dev",
    "build": "pnpm build:ui && pnpm --filter @ucm/docs build",
    "test": "pnpm --filter @ucm/ui test",
    "catalog:build": "pnpm --filter @ucm/catalog build",
    "mcp:dev": "pnpm --filter @ucm/mcp-server dev",
    "mcp:inspect": "pnpm --filter @ucm/mcp-server inspect",
    "lint:rules": "pnpm --filter @ucm/rules lint:rules",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  }
}
