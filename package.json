{
  "name": "ucm-design",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:ui": "pnpm --filter @ucm/ui build",
    "dev:docs": "pnpm build:ui && pnpm --filter @ucm/docs dev",
