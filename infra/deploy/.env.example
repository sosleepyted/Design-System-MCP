# Copy to infra/deploy/.env and fill in. Never commit the real .env.

# Comma-separated bearer tokens accepted by the MCP server. Generate strong
# random values, e.g. `openssl rand -hex 32`. Add a second token before
# retiring the first to rotate without downtime.
MCP_TOKENS=replace-with-openssl-rand-hex-32

# Cloudflare Tunnel token from the Zero Trust dashboard (Networks > Tunnels).
# Route the tunnel hostnames to http://mcp:8787 and http://registry:4873.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
